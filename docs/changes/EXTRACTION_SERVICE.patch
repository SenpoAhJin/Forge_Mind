+"""Explicit setup only. Runtime never contacts a hosted inference service."""
+from pathlib import Path
+import urllib.request
+from huggingface_hub import snapshot_download
+
+target = Path(__file__).resolve().parents[1] / 'models/reference'
+target.mkdir(parents=True, exist_ok=True)
+urllib.request.urlretrieve('https://storage.googleapis.com/mediapipe-models/pose_landmarker/pose_landmarker_lite/float16/latest/pose_landmarker_lite.task', target / 'pose_landmarker_lite.task')
+snapshot_download('openai/clip-vit-base-patch32', local_dir=target / 'clip', allow_patterns=['*.json', '*.txt', '*.safetensors', 'pytorch_model.bin'])
+for file in target.rglob('*'):
+    if file.is_file(): print(f'{file.relative_to(target)}: {file.stat().st_size} bytes')
