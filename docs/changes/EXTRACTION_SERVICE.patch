+"""Separate Flask entrypoint reusing the existing service environment and CORS."""
+from concurrent.futures import ThreadPoolExecutor, TimeoutError
+import threading
+import os
+from flask import Flask, request, jsonify
+from flask_cors import CORS
+from werkzeug.exceptions import RequestEntityTooLarge
+from reference_extraction import ReferencePipeline, ExtractionError, decode_image
+
+def create_app(pipeline=None, timeout=45):
+    app = Flask(__name__)
+    app.config['MAX_CONTENT_LENGTH'] = 1024*1024 + 64*1024
+    CORS(app)
+    pipeline = pipeline or ReferencePipeline()
+    worker = ThreadPoolExecutor(max_workers=1)
+    gate = threading.Lock()
+
+    @app.get('/api/health')
+    def health():
+        return jsonify(schema_version=1, **pipeline.health())
+
+    @app.errorhandler(RequestEntityTooLarge)
+    def too_large(_):
+        return jsonify(error={'code': 'image_too_large', 'message': 'Choose an image up to 1 MB.'}), 413
+
+    @app.post('/api/extract-reference')
+    def extract():
+        if 'image' not in request.files:
+            return jsonify(error={'code': 'missing_image', 'message': 'Upload an image field.'}), 400
+        try:
+            image = decode_image(request.files['image'].read(1024*1024+1))
+            if not gate.acquire(blocking=False):
+                raise ExtractionError('analysis_busy', 'Analysis is busy. Retry shortly.', 503)
+            def run():
+                try: return pipeline.extract(image, timeout=timeout)
+                finally: gate.release()
+            future = worker.submit(run)
+            try: return jsonify(future.result(timeout=timeout))
+            except TimeoutError:
+                raise ExtractionError('analysis_timeout', 'Analysis timed out. Retry or enter components manually.', 504)
+        except ExtractionError as error:
+            return jsonify(error={'code': error.code, 'message': error.message}), error.status
+        except Exception:
+            return jsonify(error={'code': 'analysis_failed', 'message': 'Analysis failed. Retry or enter components manually.'}), 500
+
+    return app
+
+if __name__ == '__main__':
+    create_app().run(host='0.0.0.0', port=int(os.environ.get('EXTRACTION_PORT', '5055')), debug=False)
diff --git a/src/reference_extraction.py b/src/reference_extraction.py
