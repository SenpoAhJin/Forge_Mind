--- /dev/null
+++ b/src/reference_extraction.py
@@ -0,0 +1,163 @@
+"""Local, memory-only reference analysis. No image logging or persistence."""
+import io
+import json
+import os
+from pathlib import Path
+import time
+import numpy as np
+from PIL import Image, ImageOps
+
+ROOT = Path(__file__).resolve().parents[1]
+DATA = Path(os.environ.get('FORGEMIND_VOCAB_DIR', ROOT.parent / 'forgemind-mobile/src/data'))
+KEYWORDS = json.loads((DATA / 'outfitKeywords.json').read_text())['keywords']
+PALETTE = json.loads((DATA / 'outfitPalette.json').read_text())['colors']
+ZONES = {'wig': (.2, 0, .8, .2), 'top': (.18, .2, .82, .53),
+         'gloves': (0, .42, 1, .64), 'bottom': (.2, .5, .8, .85),
+         'shoes': (.15, .85, .85, 1), 'accessory': (.25, .06, .75, .22)}
+
+class ExtractionError(Exception):
+    def __init__(self, code, message, status=400):
+        self.code, self.message, self.status = code, message, status
+
+def decode_image(raw):
+    if len(raw) > 1024 * 1024:
+        raise ExtractionError('image_too_large', 'Choose an image up to 1 MB.', 413)
+    try:
+        with Image.open(io.BytesIO(raw)) as source:
+            if source.format not in ('JPEG', 'PNG', 'WEBP'):
+                raise ExtractionError('unsupported_image', 'Choose a JPEG, PNG or WebP image.')
+            if source.width * source.height > 20_000_000:
+                raise ExtractionError('image_dimensions', 'Image exceeds 20 million pixels.')
+            source.verify()
+        with Image.open(io.BytesIO(raw)) as source:
+            return ImageOps.exif_transpose(source).convert('RGB')
+    except ExtractionError:
+        raise
+    except Exception:
+        raise ExtractionError('unreadable_image', 'The file is not a readable JPEG, PNG or WebP image.') from None
+
+def lab(rgb):
+    rgb = np.asarray(rgb, dtype=float) / 255
+    linear = np.where(rgb <= .04045, rgb / 12.92, ((rgb + .055) / 1.055) ** 2.4)
+    xyz = linear @ np.array([[.4124564, .3575761, .1804375], [.2126729, .7151522, .0721750], [.0193339, .1191920, .9503041]]).T
+    xyz /= [.95047, 1, 1.08883]
+    f = np.where(xyz > .008856, np.cbrt(xyz), 7.787 * xyz + 16 / 116)
+    return np.stack([116*f[..., 1]-16, 500*(f[..., 0]-f[..., 1]), 200*(f[..., 1]-f[..., 2])], axis=-1)
+
+PALETTE_LAB = lab([[int(c['hex'][i:i+2], 16) for i in (1, 3, 5)] for c in PALETTE])
+
+def colors(crop, mask=None, baseline=False):
+    pixels = np.asarray(crop).reshape(-1, 3)
+    if mask is not None:
+        pixels = pixels[mask.reshape(-1) > .5]
+        # Conservative RGB skin heuristic; imperfect, documented and only used with a person mask.
+        r, g, b = pixels.T if len(pixels) else ([], [], [])
+        if len(pixels):
+            skin = (r > 95) & (g > 40) & (b > 20) & (r > g) & (r > b) & ((r.astype(float)-g) > 15)
+            pixels = pixels[~skin]
+    if not len(pixels):
+        return []
+    values = lab(pixels)
+    if baseline:
+        groups = [np.arange(len(pixels))]
+    else:
+        bins = np.floor(values / [8, 12, 12]).astype(int)
+        _, inverse, counts = np.unique(bins, axis=0, return_inverse=True, return_counts=True)
+        groups = [np.flatnonzero(inverse == i) for i in np.argsort(-counts, kind='stable')[:3]]
+    result = []
+    for group in groups:
+        rgb = np.round(pixels[group].mean(axis=0)).astype(int)
+        target = lab(rgb)
+        idx = int(np.argmin(np.linalg.norm(PALETTE_LAB - target, axis=1)))
+        result.append({'hex': '#'+''.join(f'{v:02X}' for v in rgb), 'share': round(len(group)/len(pixels), 5), 'palette_id': PALETTE[idx]['id']})
+    return result
+
+def foreground_box(image):
+    """Heuristic extent, never described as a detected person."""
+    a = np.asarray(image)
+    edge = np.concatenate([a[0], a[-1], a[:, 0], a[:, -1]])
+    background = np.median(edge, axis=0)
+    ys, xs = np.where(np.linalg.norm(a.astype(float)-background, axis=2) > 35)
+    if len(xs) < a.shape[0]*a.shape[1]*.03:
+        return (0., 0., 1., 1.)
+    return (float(xs.min()/image.width), float(ys.min()/image.height), float((xs.max()+1)/image.width), float((ys.max()+1)/image.height))
+
+class ReferencePipeline:
+    def __init__(self, load_models=True):
+        self.pose = self.clip = self.processor = None
+        self.model_errors = []
+        if load_models:
+            try:
+                import mediapipe as mp
+                self.mp = mp
+                model = ROOT / 'models/reference/pose_landmarker_lite.task'
+                self.pose = mp.tasks.vision.PoseLandmarker.create_from_options(mp.tasks.vision.PoseLandmarkerOptions(
+                    base_options=mp.tasks.BaseOptions(model_asset_path=str(model)), num_poses=2,
+                    output_segmentation_masks=True, min_pose_detection_confidence=.6))
+            except Exception as error:
+                self.model_errors.append('pose unavailable: ' + type(error).__name__)
+            try:
+                from transformers import CLIPModel, CLIPProcessor
+                model = str(ROOT / 'models/reference/clip')
+                self.processor = CLIPProcessor.from_pretrained(model, local_files_only=True)
+                self.clip = CLIPModel.from_pretrained(model, local_files_only=True).eval()
+            except Exception as error:
+                self.model_errors.append('style unavailable: ' + type(error).__name__)
+
+    def health(self):
+        return {'pose_loaded': self.pose is not None, 'style_loaded': self.clip is not None, 'warnings': self.model_errors}
+
+    def extract(self, image, baseline=False, timeout=45):
+        deadline = time.monotonic() + timeout
+        def check():
+            if time.monotonic() > deadline:
+                raise ExtractionError('analysis_timeout', 'Analysis timed out. Retry or enter components manually.', 504)
+        image_size = {'width': image.width, 'height': image.height}
+        image = image.copy()
+        image.thumbnail((768, 1024))
+        method, mask, landmarks = 'fallback', None, None
+        box = foreground_box(image)
+        warnings = ['Fixed proportion zones; person detection was not established. Please check.']
+        if self.pose and not baseline:
+            check()
+            result = self.pose.detect(self.mp.Image(image_format=self.mp.ImageFormat.SRGB, data=np.asarray(image)))
+            if len(result.pose_landmarks) == 1:
+                points = result.pose_landmarks[0]
+                if all(points[i].visibility > .6 for i in (0, 11, 12, 15, 16, 23, 24, 27, 28)):
+                    method, landmarks, warnings = 'pose', points, []
+                    if result.segmentation_masks:
+                        mask = result.segmentation_masks[0].numpy_view()
+                        ys, xs = np.where(mask > .5)
+                        if len(xs): box = (float(xs.min()/image.width), float(ys.min()/image.height), float((xs.max()+1)/image.width), float((ys.max()+1)/image.height))
+        components = []
+        for slot, zone in ZONES.items():
+            check()
+            x0, y0, x1, y1 = box
+            z = [x0+zone[0]*(x1-x0), y0+zone[1]*(y1-y0), x0+zone[2]*(x1-x0), y0+zone[3]*(y1-y0)]
+            if landmarks and slot == 'gloves':
+                hands = [landmarks[i] for i in (15, 16, 19, 20)]
+                z = [min(p.x for p in hands)-.05, min(p.y for p in hands)-.05, max(p.x for p in hands)+.05, max(p.y for p in hands)+.05]
+            z = [float(max(0, min(1, v))) for v in z]
+            px = (int(z[0]*image.width), int(z[1]*image.height), max(int(z[0]*image.width)+1, int(z[2]*image.width)), max(int(z[1]*image.height)+1, int(z[3]*image.height)))
+            crop = image.crop(px)
+            local_warnings = list(warnings)
+            if slot == 'gloves': local_warnings.append('Hand regions can include skin or nearby clothing. Please check.')
+            candidates = []
+            labels = KEYWORDS.get(slot, [])
+            if self.clip and labels and not baseline:
+                import torch
+                with torch.inference_mode():
+                    inputs = self.processor(text=[f'a photo of {label.replace("-", " ")} {slot}' for label in labels], images=crop, return_tensors='pt', padding=True)
+                    scores = self.clip(**inputs).logits_per_image[0].tolist()
+                candidates = sorted([{'label': label, 'score': round(float(score), 5)} for label, score in zip(labels, scores)], key=lambda c: -c['score'])[:3]
+            else:
+                local_warnings.append('No style vocabulary for accessory.' if not labels else 'Style model unavailable.' if not baseline else 'Evaluation baseline has no style model.')
+            gap = candidates[0]['score']-candidates[1]['score'] if len(candidates)>1 else 0
+            band = 'high' if gap >= 4 else 'medium' if gap >= 2 else 'low'
+            if method == 'fallback' or not candidates: band = 'low'
+            crop_mask = mask[px[1]:px[3], px[0]:px[2]] if mask is not None else None
+            found_colors = colors(crop, crop_mask, baseline)
+            if not found_colors: local_warnings.append('No unmasked color pixels. Please check.')
+            components.append({'type': slot, 'zone': z, 'colors': found_colors, 'style': candidates[0]['label'] if candidates else None, 'candidates': candidates, 'band': band, 'warnings': local_warnings})
+        check()
+        return {'schema_version': 1, 'image': image_size, 'method': method, 'mode': 'baseline' if baseline else 'full', 'components': components, 'warnings': warnings}
