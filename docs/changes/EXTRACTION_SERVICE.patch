+"""Run: python scripts/evaluate_reference.py labeled-folder --output results.json
+
+labels.json: {"version":1,"images":[{"file":"image.jpg","slots":{"wig":{"color":"white","style":"spiky"}}}]}
+Omit unlabelled slots/fields. Style labels must be in the app vocabulary; accessory has none.
+"""
+import argparse
+import json
+from pathlib import Path
+import sys
+sys.path.insert(0, str(Path(__file__).resolve().parents[1] / 'src'))
+from reference_extraction import ReferencePipeline, decode_image, KEYWORDS, PALETTE, ZONES
+
+def evaluate(folder, pipeline):
+    labels = json.loads((folder / 'labels.json').read_text(encoding='utf-8-sig'))
+    if labels.get('version') != 1 or not isinstance(labels.get('images'), list): raise ValueError('Invalid label schema')
+    if not labels['images']: return {'status': 'NOT RUN', 'reason': 'No labeled images.', 'number_of_images': 0}
+    if not all(pipeline.health()[key] for key in ('pose_loaded', 'style_loaded')): raise RuntimeError('Full evaluation requires both models loaded.')
+    rows = []
+    counters = {mode: {slot: {metric: {'correct': 0, 'total': 0} for metric in ('color', 'style_top1')} for slot in ZONES} for mode in ('full', 'baseline')}
+    for entry in labels['images']:
+        path = (folder / entry['file']).resolve()
+        if not path.is_relative_to(folder.resolve()): raise ValueError('Image outside labeled folder')
+        for slot, values in entry['slots'].items():
+            if slot not in ZONES: raise ValueError('Unknown slot')
+            if 'color' in values and values['color'] not in [c['id'] for c in PALETTE]: raise ValueError('Unknown color')
+            if 'style' in values and values['style'] not in KEYWORDS.get(slot, []): raise ValueError('Unknown style')
+        image = decode_image(path.read_bytes())
+        row = {'file': entry['file']}
+        for mode in counters:
+            result = pipeline.extract(image, baseline=mode == 'baseline', timeout=120)
+            row[mode] = result
+            for component in result['components']:
+                slot = component['type']; truth = entry['slots'].get(slot, {})
+                predicted = {'color': component['colors'][0]['palette_id'] if component['colors'] else None, 'style_top1': component['style']}
+                for metric, field in (('color', 'color'), ('style_top1', 'style')):
+                    if field in truth:
+                        counter = counters[mode][slot][metric]; counter['total'] += 1
+                        counter['correct'] += int(predicted[metric] == truth[field])
+        rows.append(row)
+    for slots in counters.values():
+        for metrics in slots.values():
+            for counter in metrics.values(): counter['accuracy'] = counter['correct']/counter['total'] if counter['total'] else None
+    comparison = {slot: {metric: (counters['full'][slot][metric]['accuracy']-counters['baseline'][slot][metric]['accuracy']) if counters['full'][slot][metric]['total'] else None for metric in ('color', 'style_top1')} for slot in ZONES}
+    return {'status': 'RAN', 'number_of_images': len(rows), 'metrics': counters, 'full_minus_baseline': comparison, 'predictions': rows}
+
