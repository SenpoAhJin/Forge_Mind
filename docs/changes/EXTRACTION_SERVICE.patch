+import io
+import sys
+import time
+from pathlib import Path
+sys.path.insert(0, str(Path(__file__).resolve().parents[1] / 'src'))
+from PIL import Image
+from reference_extraction import ReferencePipeline, colors, decode_image, ExtractionError
+from reference_api import create_app
+import pytest
+
+def png():
+    buffer = io.BytesIO()
+    Image.new('RGB', (80, 200), '#EF4444').save(buffer, format='PNG')
+    return buffer.getvalue()
+
+def test_known_color_histogram_and_average():
+    for baseline in (False, True):
+        result = colors(Image.new('RGB', (30, 30), '#EF4444'), baseline=baseline)
+        assert result == [{'hex': '#EF4444', 'share': 1.0, 'palette_id': 'red'}]
+
+def test_fallback_all_six_low_and_normalized():
+    result = ReferencePipeline(False).extract(decode_image(png()))
+    assert result['method'] == 'fallback'
+    assert len(result['components']) == 6
+    for c in result['components']:
+        assert c['band'] == 'low' and c['warnings']
+        assert all(0 <= n <= 1 for n in c['zone'])
+
+@pytest.mark.parametrize('data', [b'not an image', b'\x89PNG\r\n\x1a\ncorrupt'])
+def test_corrupt_and_nonimage(data):
+    with pytest.raises(ExtractionError): decode_image(data)
+
+def test_api_upload_health_cors_and_oversize():
+    client = create_app(ReferencePipeline(False)).test_client()
+    response = client.post('/api/extract-reference', data={'image': (io.BytesIO(png()), 'wrong.exe')}, headers={'Origin': 'http://localhost:8091'})
+    assert response.status_code == 200
+    assert response.headers['Access-Control-Allow-Origin'] == 'http://localhost:8091'
+    assert client.get('/api/health').json['pose_loaded'] is False
+    response = client.post('/api/extract-reference', data={'image': (io.BytesIO(b'x'*(1024*1024+1)), 'big.png')})
+    assert response.status_code == 413
+    assert response.json['error']['code'] == 'image_too_large'
+
+def test_timeout():
+    class Slow(ReferencePipeline):
+        def extract(self, *args, **kwargs): time.sleep(.1); return {}
+    client = create_app(Slow(False), timeout=.01).test_client()
+    response = client.post('/api/extract-reference', data={'image': (io.BytesIO(png()), 'image.png')})
+    assert response.status_code == 504
+    assert response.json['error']['code'] == 'analysis_timeout'
